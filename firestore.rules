rules_version = '2';

/**
 * CashFlow Forecast - Firestore Security Rules
 * =============================================
 * 
 * Database Structure:
 * - users/{userId} - User profile
 * - users/{userId}/accounts/{accountId} - Payment accounts
 * - users/{userId}/income/{incomeId} - Income sources
 * - users/{userId}/transactions/{transactionId} - Transactions
 * - users/{userId}/rules/{ruleId} - Category mapping rules
 * - users/{userId}/reviews/{transactionId} - Inflow review state (FIN-INCOME-001)
 * - users/{userId}/links/{linkId} - Transaction links, integer cents (FIN-RELATION-001)
 * - users/{userId}/reviewCandidates/{identityKey} - Review candidates (FIN-RELATION-001)
 * - users/{userId}/serviceFamilies/{familyId} - Owner's service identities (FIN-DUPLICATE-001)
 *
 * Security Principles:
 * 1. Users can only access their own data
 * 2. All writes require authentication
 * 3. Data validation on write operations
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================
    // Helper Functions
    // =========================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user owns this document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Validate string field
    function isValidString(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }
    
    // Validate number field
    function isValidNumber(field, min, max) {
      return field is number && field >= min && field <= max;
    }

    // ---------------------------------------------------------------
    // Shape checks shared by create AND update.
    //
    // These exist as functions because `allow update: if isOwner(userId)` alone made
    // the create-time validation decorative: one updateDoc could set amount to
    // -999999, type to garbage, or blank a mapping rule's needle — the empty needle
    // that create explicitly guards against because it would rewrite every row the
    // user owns. `links` already re-asserted its invariants on update; these did not.
    // ---------------------------------------------------------------

    function isValidTransactionShape(d) {
      return d.keys().hasAll(['title', 'amount', 'type', 'category', 'paymentMethod', 'date']) &&
        isValidString(d.title, 1, 200) &&
        d.amount is number &&
        // >= 0: real exports contain $0.00 rows (fee reversals, balance adjustments)
        // and one rejected row fails its entire write batch.
        d.amount >= 0 &&
        d.type in ['expense', 'income', 'transfer'];
    }

    function isValidMappingRuleShape(d) {
      return d.keys().hasAll(['match', 'set', 'createdAt', 'enabled']) &&
        // Bracket-indexed, not dotted: `match` is a keyword in the rules language.
        d['match']['field'] in ['merchant', 'title', 'description'] &&
        d['match']['op'] in ['contains', 'equals'] &&
        // Non-empty: an empty needle would match and rewrite every row the user owns.
        isValidString(d['match']['value'], 1, 200) &&
        d.enabled is bool;
    }
    
    // =========================================
    // User Profile Rules
    // =========================================
    
    match /users/{userId} {
      // Allow users to read their own profile
      allow read: if isOwner(userId);
      
      // Allow users to create their own profile
      allow create: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'settings', 'metadata']) &&
        request.resource.data.uid == userId;
      
      // Allow users to update their own profile
      allow update: if isOwner(userId) &&
        // Prevent changing uid
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']));
      
      // Allow users to delete their own profile
      allow delete: if isOwner(userId);
      
      // =========================================
      // Payment Accounts Subcollection
      // =========================================
      
      match /accounts/{accountId} {
        // Users can read their own accounts
        allow read: if isOwner(userId);
        
        // Users can create accounts with required fields.
        //
        // `openingBalance`, NOT `balance`: PaymentAccount (src/types/index.ts) has no
        // field called `balance` and never has. The old rule demanded one, so every
        // hand-created account was denied — invisible in production only because the
        // Python sync functions use the Admin SDK and bypass rules entirely.
        //
        // `personal_loan` is the fifth AccountType (onboarding creates one). Omitting
        // it denied every loan account for the same silent reason.
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasAll(['name', 'type', 'provider', 'openingBalance', 'isActive']) &&
          isValidString(request.resource.data.name, 1, 100) &&
          request.resource.data.type in ['credit_card', 'debit_card', 'bank_account', 'cash', 'personal_loan'] &&
          request.resource.data.openingBalance is number;
        
        // Users can update their accounts
        allow update: if isOwner(userId);
        
        // Users can delete their accounts
        allow delete: if isOwner(userId);
      }
      
      // =========================================
      // Income Sources Subcollection
      // =========================================
      
      match /income/{incomeId} {
        // Users can read their own income sources
        allow read: if isOwner(userId);
        
        // Users can create income sources with required fields
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasAll(['name', 'amount', 'frequency', 'isActive']) &&
          isValidString(request.resource.data.name, 1, 100) &&
          request.resource.data.amount is number &&
          request.resource.data.frequency in ['weekly', 'biweekly', 'monthly', 'yearly'];
        
        // Users can update their income sources
        allow update: if isOwner(userId);
        
        // Users can delete their income sources
        allow delete: if isOwner(userId);
      }
      
      // =========================================
      // Transactions Subcollection
      // =========================================
      
      match /transactions/{transactionId} {
        // Users can read their own transactions
        allow read: if isOwner(userId);
        
        // Users can create transactions with required fields
        allow create: if isOwner(userId) &&
          isValidTransactionShape(request.resource.data);

        // Same shape on update — an edit cannot land what a create could not.
        allow update: if isOwner(userId) &&
          isValidTransactionShape(request.resource.data);
        
        // Users can delete their transactions
        allow delete: if isOwner(userId);
      }
      
      // =========================================
      // Mapping Rules Subcollection
      // =========================================
      // "anything from Instacart is Groceries" — the owner's durable recategorization
      // rules. Own subcollection, never profile.settings (which is rebuilt from a
      // whitelist on sync and would drop them). See src/lib/mapping-rules.ts.

      match /rules/{ruleId} {
        // Users can read their own rules
        allow read: if isOwner(userId);

        // Users can create rules with a well-formed matcher
        allow create: if isOwner(userId) &&
          isValidMappingRuleShape(request.resource.data);

        // Enable/disable is an update, so the matcher must survive one. Without this
        // a toggle could also blank the needle.
        allow update: if isOwner(userId) &&
          isValidMappingRuleShape(request.resource.data);

        // Users can delete their rules
        allow delete: if isOwner(userId);
      }

      // =========================================
      // Inflow Reviews Subcollection (FIN-INCOME-001)
      // =========================================
      // "this credit is a gift, not my salary" — the owner's decision about one
      // inflow. Doc id IS the transaction id, so there is at most one per row.
      // Review state lives HERE and not on the transaction, so confirming a
      // classification never rewrites provider data. See src/types/index.ts
      // (InflowReview) and src/lib/classify.ts (selectInflowReviewQueue).

      match /reviews/{transactionId} {
        allow read: if isOwner(userId);

        // Shape only. The allowed `meaning` values are FINANCIAL_MEANINGS in
        // application code and are deliberately NOT copied here — a second list of
        // meaning strings is a second source of truth for what counts as income,
        // which is the exact defect this task removes. The client validates against
        // the enum with isFinancialMeaning() before writing.
        allow write: if isOwner(userId) &&
          request.resource.data.state in
            ['unreviewed', 'suggested', 'confirmed', 'dismissed', 'needs_attention'] &&
          request.resource.data.transactionId == transactionId &&
          request.resource.data.source in ['user', 'system'];

        allow delete: if isOwner(userId);
      }

      // =========================================
      // Audit Log (AUD-1)
      // =========================================
      // What CHANGED, as opposed to obs/provenance.ts which explains how a number was
      // computed from today's inputs. Append-only in the sense that matters: an entry
      // can never be rewritten. Delete IS allowed, because account deletion is a
      // privacy promise and this holds the owner's financial data — so the log can be
      // erased wholesale but never quietly falsified.
      //
      // `at` is stamped by auditEntry() rather than trusted from the client, and the
      // rule below refuses an entry that omits the fields that make it addressable.

      match /audit/{entryId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasAll(['at', 'actor', 'action', 'target']) &&
          request.resource.data.actor in ['user', 'sync', 'import', 'batch', 'restore'] &&
          request.resource.data.action is string &&
          request.resource.data.target is string;

        // A log that can be edited is a table.
        allow update: if false;

        allow delete: if isOwner(userId);
      }

      // =========================================
      // Transaction Links Subcollection (FIN-RELATION-001)
      // =========================================
      // An auditable statement that one transaction acts on another: a refund against a
      // purchase, a bank debit against a card statement, a duplicate against its twin.
      // Amounts are INTEGER CENTS. Doc id is `linkType~source~target`, so re-proposing
      // the same relation is an upsert and there is nothing to dedupe.
      // See src/lib/relations.ts — the same predicate runs in the client validator.
      //
      // These rules validate SHAPE and OWNERSHIP. They do not re-implement the
      // allocation sums (V4/V5): cross-document totals are not expressible here without
      // reads that cost money on every write. The pure validator and the store own
      // those, and relations.test.ts R11/R12 prove them.

      match /links/{linkId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasAll([
            'linkType', 'sourceTransactionId', 'targetTransactionId',
            'allocatedAmountCents', 'status', 'algorithmVersion', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.linkType in [
            'refund_of', 'partial_refund_of', 'reversal_of', 'chargeback_for',
            'card_payment_pair', 'reimbursement_for', 'repayment_of',
            'duplicate_candidate', 'subscription_overlap'
          ] &&
          request.resource.data.status in
            ['suggested', 'confirmed', 'rejected', 'superseded', 'provisional'] &&
          isValidString(request.resource.data.sourceTransactionId, 1, 128) &&
          isValidString(request.resource.data.targetTransactionId, 1, 128) &&
          // No self-link. The cheapest correctness rule in the file.
          request.resource.data.sourceTransactionId != request.resource.data.targetTransactionId &&
          // Integer cents, strictly positive. A float allocation is how a ledger drifts.
          request.resource.data.allocatedAmountCents is int &&
          request.resource.data.allocatedAmountCents > 0;

        // Update re-asserts every create-time invariant: an update path that only checks
        // ownership is a validator with a hole in it.
        allow update: if isOwner(userId) &&
          request.resource.data.linkType == resource.data.linkType &&
          request.resource.data.sourceTransactionId == resource.data.sourceTransactionId &&
          request.resource.data.targetTransactionId == resource.data.targetTransactionId &&
          request.resource.data.status in
            ['suggested', 'confirmed', 'rejected', 'superseded', 'provisional'] &&
          request.resource.data.allocatedAmountCents is int &&
          request.resource.data.allocatedAmountCents > 0;

        // A rejected link is the suppression record. Deleting it makes the suggestion
        // return — and with no delete path, "duplicate detection never deletes a
        // transaction" is mechanically true rather than a promise.
        allow delete: if false;
      }

      // =========================================
      // Review Candidates Subcollection (FIN-RELATION-001)
      // =========================================
      // An UNAPPLIED proposal. Doc id is the identityKey — candidate type + sorted
      // transaction ids, deliberately WITHOUT the algorithm version, so a dismissal
      // survives a version bump. The version lives in the `candidateId` field for audit.
      // The document carries no merchant string, title, description or account name.
      // See src/lib/candidates.ts.

      match /reviewCandidates/{candidateId} {
        allow read: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasAll([
            'candidateId', 'candidateType', 'algorithmVersion',
            'transactionIds', 'status', 'score', 'generatedAt'
          ]) &&
          request.resource.data.candidateType in [
            'refund_match', 'combined_refund_match', 'partial_refund_match',
            'unknown_card_credit', 'immediate_duplicate_charge', 'duplicate_subscription',
            'subscription_overlap', 'continued_charge_after_cancellation'
          ] &&
          request.resource.data.status in [
            'unreviewed', 'suggested', 'confirmed', 'dismissed',
            'intentional', 'needs_more_information'
          ] &&
          request.resource.data.transactionIds is list &&
          request.resource.data.transactionIds.size() >= 2 &&
          request.resource.data.transactionIds.size() <= 13;

        // A decision is a record.
        allow delete: if false;
      }

      // =========================================
      // Service Families Subcollection (FIN-DUPLICATE-001)
      // =========================================
      // The owner's own service identities, seeded from their data — never a shipped
      // vendor list. `aliases` carry normalized merchant strings, which is why they live
      // uid-scoped here and never in telemetry or a candidate document.
      //
      // Added in FIN-RELATION-001's single rules pass on purpose: firestore.rules is
      // owned by one task for this programme so the other three never contend on it
      // (FIN-DUPLICATE-001 §12.1 precondition 8). The engine is FIN-DUPLICATE-001's.

      match /serviceFamilies/{familyId} {
        allow read: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasAll(['label', 'aliases', 'createdAt', 'updatedAt']) &&
          isValidString(request.resource.data.label, 1, 100) &&
          request.resource.data.aliases is list &&
          request.resource.data.aliases.size() <= 50;

        // The owner may retire a family they created; nothing automatic deletes one.
        allow delete: if isOwner(userId);
      }

      // =========================================
      // Budgets Subcollection (Future Feature)
      // =========================================

      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }

      // =========================================
      // Planned Transactions, Goals, Reminders
      // =========================================
      // These had NO match block, so the deny-all at the bottom of this file caught
      // them and the app's own writes were rejected in production. The planned-payments
      // panel (src/components/PlannedPaymentsPanel.tsx) reads and writes
      // plannedTransactions live; goals and reminders are reachable from
      // deleteAllUserData, which would also have failed part-way.

      match /plannedTransactions/{plannedId} {
        allow read: if isOwner(userId);

        // Carries money, so it gets the same shape treatment as a transaction:
        // an amount that is a number and not negative, on create and on update.
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasAll(['title', 'amount', 'dueDate']) &&
          isValidString(request.resource.data.title, 1, 200) &&
          request.resource.data.amount is number &&
          request.resource.data.amount >= 0;

        allow delete: if isOwner(userId);
      }

      // Owner-only, no shape check — same posture as budgets above. Neither holds a
      // value any calculation depends on; tighten if that changes.
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      match /reminders/{reminderId} {
        allow read, write: if isOwner(userId);
      }

      // =========================================
      // Bills register (BILLS-001)
      // =========================================
      // Manually curated recurring obligations driving the autopay migration.
      // Carries money, so it gets the transaction-style shape treatment. A new
      // collection MUST have a match block here or the deny-all below silently
      // rejects the app's own writes (see the plannedTransactions note above).
      match /bills/{billId} {
        allow read: if isOwner(userId);

        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasAll(['vendor', 'amount', 'frequency', 'paymentMethodId', 'migrationStatus', 'lifecycleStatus']) &&
          isValidString(request.resource.data.vendor, 1, 200) &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0 &&
          request.resource.data.frequency in ['weekly', 'biweekly', 'monthly', 'quarterly', 'semiannual', 'annual'] &&
          request.resource.data.migrationStatus in ['to-review', 'to-switch', 'switched', 'exception', 'no-change-needed'] &&
          request.resource.data.lifecycleStatus in ['active', 'cancel-planned', 'cancelled'];

        allow delete: if isOwner(userId);
      }
    }
    
    // =========================================
    // Deny all other access
    // =========================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

