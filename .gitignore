# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# firebase deploy cache
/.firebase/

# swc cache
/.swc/

# typescript
*.tsbuildinfo
next-env.d.ts
transactionsbyaccount/
scripts/backups/

# playwright (OBS-001) — artifacts may contain a rendered Accounts page; never commit
/test-results/
/playwright-report/
/playwright/.cache/
/diagnostic-bundles/

# python: virtualenv and bytecode are build output, never source.
# The venv alone was 7,124 tracked files (97% of the repo) and dirtied the tree
# on every test run; its bundled playwright driver (113MB) also exceeds GitHub's
# 100MB blob limit, which blocked `git push`.
functions-sync/venv/
**/__pycache__/
*.py[cod]

# firebase emulator
firebase-debug.log
firestore-debug.log
