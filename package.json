{
  "name": "cashflow-forecast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:ci": "jest --ci --testPathIgnorePatterns \"/node_modules/\" \"/\\.next/\" \"/functions/\" \"/e2e/\" \"/src/__tests__/flows\\.integration\\.test\\.ts$\"",
    "test:watch": "jest --watch",
    "test:rules": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" FIREBASE_CLI_EXPERIMENTS=webframeworks npx --yes firebase-tools emulators:exec --only firestore --project demo-cashflow-rules \"node --test rules-tests/firestore-rules.mjs\"",
    "test:coverage": "jest --coverage",
    "deploy": "sh scripts/predeploy.sh && firebase deploy --only hosting",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "diag:export": "node scripts/diagnostics/export-trace.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "date-fns": "^4.1.0",
    "firebase": "^12.7.0",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "openai": "^6.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  }
}
