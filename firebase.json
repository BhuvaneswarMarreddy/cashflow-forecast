{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "api",
      "predeploy": ["npm --prefix functions run build"]
    },
    {
      "source": "functions-sync",
      "codebase": "sync",
      "runtime": "python312"
    }
  ],
  "hosting": {
    "source": ".",
    "frameworksBackend": {
      "region": "us-central1"
    },
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}

